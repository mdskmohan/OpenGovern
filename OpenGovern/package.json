{
  "name": "opengovern",
  "version": "1.0.0",
  "description": "Enterprise Data Governance Platform built on OpenMetadata and Open Policy Agent",
  "main": "index.js",
  "scripts": {
    "install:all": "npm install && cd services/auth-service && npm install && cd ../core-api && npm install && cd ../governance-service && npm install && cd ../quality-service && npm install && cd ../notification-service && npm install && cd ../../shared/types && npm install && cd ../../frontend && npm install",
    "dev": "concurrently \"npm run dev:auth\" \"npm run dev:api\" \"npm run dev:governance\" \"npm run dev:quality\" \"npm run dev:notifications\" \"npm run dev:frontend\"",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:auth": "cd services/auth-service && npm run dev",
    "dev:api": "cd services/core-api && npm run dev",
    "dev:governance": "cd services/governance-service && npm run dev",
    "dev:quality": "cd services/quality-service && npm run dev",
    "dev:notifications": "cd services/notification-service && npm run dev",
    "build": "npm run build:types && npm run build:services && npm run build:frontend",
    "build:types": "cd shared/types && npm run build",
    "build:frontend": "cd frontend && npm run build",
    "build:services": "npm run build:auth && npm run build:api && npm run build:governance && npm run build:quality && npm run build:notifications",
    "build:auth": "cd services/auth-service && npm run build",
    "build:api": "cd services/core-api && npm run build",
    "build:governance": "cd services/governance-service && npm run build",
    "build:quality": "cd services/quality-service && npm run build",
    "build:notifications": "cd services/notification-service && npm run build",
    "test": "npm run test:frontend && npm run test:backend",
    "test:frontend": "cd frontend && npm run test",
    "test:backend": "npm run test:metadata-service && npm run test:policy-service && npm run test:workflow-service && npm run test:alerts-service && npm run test:integration-service && npm run test:ai-service && npm run test:reverse-sync-service",
    "test:metadata-service": "cd backend/metadata-service && npm run test",
    "test:policy-service": "cd backend/policy-service && npm run test",
    "test:workflow-service": "cd backend/workflow-service && npm run test",
    "test:alerts-service": "cd backend/alerts-service && npm run test",
    "test:integration-service": "cd backend/integration-service && npm run test",
    "test:ai-service": "cd backend/ai-service && npm run test",
    "test:reverse-sync-service": "cd backend/reverse-metadata-sync-service && npm run test",
    "lint": "npm run lint:frontend && npm run lint:backend",
    "lint:frontend": "cd frontend && npm run lint",
    "lint:backend": "npm run lint:metadata-service && npm run lint:policy-service && npm run lint:workflow-service && npm run lint:alerts-service && npm run lint:integration-service && npm run lint:ai-service && npm run lint:reverse-sync-service",
    "lint:metadata-service": "cd backend/metadata-service && npm run lint",
    "lint:policy-service": "cd backend/policy-service && npm run lint",
    "lint:workflow-service": "cd backend/workflow-service && npm run lint",
    "lint:alerts-service": "cd backend/alerts-service && npm run lint",
    "lint:integration-service": "cd backend/integration-service && npm run lint",
    "lint:ai-service": "cd backend/ai-service && npm run lint",
    "lint:reverse-sync-service": "cd backend/reverse-metadata-sync-service && npm run lint",
    "type-check": "npm run type-check:frontend && npm run type-check:backend",
    "type-check:frontend": "cd frontend && npm run type-check",
    "type-check:backend": "npm run type-check:metadata-service && npm run type-check:policy-service && npm run type-check:workflow-service && npm run type-check:alerts-service && npm run type-check:integration-service && npm run type-check:ai-service && npm run type-check:reverse-sync-service",
    "type-check:metadata-service": "cd backend/metadata-service && npm run type-check",
    "type-check:policy-service": "cd backend/policy-service && npm run type-check",
    "type-check:workflow-service": "cd backend/workflow-service && npm run type-check",
    "type-check:alerts-service": "cd backend/alerts-service && npm run type-check",
    "type-check:integration-service": "cd backend/integration-service && npm run type-check",
    "type-check:ai-service": "cd backend/ai-service && npm run type-check",
    "type-check:reverse-sync-service": "cd backend/reverse-metadata-sync-service && npm run type-check",
    "docker:build": "docker-compose -f infrastructure/docker/docker-compose.yml build",
    "docker:up": "docker-compose -f infrastructure/docker/docker-compose.yml up -d",
    "docker:down": "docker-compose -f infrastructure/docker/docker-compose.yml down",
    "docker:logs": "docker-compose -f infrastructure/docker/docker-compose.yml logs -f",
    "clean": "npm run clean:frontend && npm run clean:backend && npm run clean:node_modules",
    "clean:frontend": "cd frontend && rm -rf .next node_modules",
    "clean:backend": "find backend -name 'node_modules' -type d -exec rm -rf {} + 2>/dev/null || true && find backend -name 'dist' -type d -exec rm -rf {} + 2>/dev/null || true",
    "clean:node_modules": "rm -rf node_modules",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "prepare": "husky install",
    "release": "standard-version",
    "docs:build": "cd docs && npm run build",
    "docs:serve": "cd docs && npm run serve",
    "test:all": "npm run test",
    "test:ci": "npm run test -- --coverage --watchAll=false --passWithNoTests",
    "test:integration": "npm run test:integration:frontend && npm run test:integration:backend",
    "test:integration:frontend": "cd frontend && npm run test:integration",
    "test:integration:backend": "concurrently \"npm run test:integration:metadata-service\" \"npm run test:integration:policy-service\" \"npm run test:integration:workflow-service\" \"npm run test:integration:alerts-service\" \"npm run test:integration:integration-service\" \"npm run test:integration:ai-service\" \"npm run test:integration:reverse-sync-service\"",
    "test:integration:metadata-service": "cd backend/metadata-service && npm run test:integration",
    "test:integration:policy-service": "cd backend/policy-service && npm run test:integration",
    "test:integration:workflow-service": "cd backend/workflow-service && npm run test:integration",
    "test:integration:alerts-service": "cd backend/alerts-service && npm run test:integration",
    "test:integration:integration-service": "cd backend/integration-service && npm run test:integration",
    "test:integration:ai-service": "cd backend/ai-service && npm run test:integration",
    "test:integration:reverse-sync-service": "cd backend/reverse-metadata-sync-service && npm run test:integration",
    "test:e2e": "cd frontend && npm run test:e2e",
    "test:smoke": "npm run test:smoke:frontend && npm run test:smoke:backend",
    "test:smoke:frontend": "cd frontend && npm run test:smoke",
    "test:smoke:backend": "concurrently \"npm run test:smoke:metadata-service\" \"npm run test:smoke:policy-service\" \"npm run test:smoke:workflow-service\" \"npm run test:smoke:alerts-service\" \"npm run test:smoke:integration-service\" \"npm run test:smoke:ai-service\" \"npm run test:smoke:reverse-sync-service\"",
    "test:smoke:metadata-service": "cd backend/metadata-service && npm run test:smoke",
    "test:smoke:policy-service": "cd backend/policy-service && npm run test:smoke",
    "test:smoke:workflow-service": "cd backend/workflow-service && npm run test:smoke",
    "test:smoke:alerts-service": "cd backend/alerts-service && npm run test:smoke",
    "test:smoke:integration-service": "cd backend/integration-service && npm run test:smoke",
    "test:smoke:ai-service": "cd backend/ai-service && npm run test:smoke",
    "test:smoke:reverse-sync-service": "cd backend/reverse-metadata-sync-service && npm run test:smoke",
    "build:all": "npm run build",
    "build:ci": "npm run build --if-present",
    "deploy:check": "npm run deploy:check:config && npm run deploy:check:security && npm run deploy:check:performance",
    "deploy:check:config": "node scripts/check-deployment-config.js",
    "deploy:check:security": "node scripts/check-security-config.js",
    "deploy:check:performance": "node scripts/check-performance-config.js",
    "quality:summary": "node scripts/generate-quality-summary.js",
    "db:migrate": "cd backend/metadata-service && npm run db:migrate",
    "db:rollback": "cd backend/metadata-service && npm run db:rollback",
    "db:seed": "cd backend/metadata-service && npm run db:seed",
    "cache:clear": "redis-cli FLUSHALL",
    "logs:tail": "docker-compose -f infrastructure/docker/docker-compose.yml logs -f",
    "monitoring:health": "curl -f http://localhost:3000/api/health || exit 1",
    "backup:create": "node scripts/create-backup.js",
    "backup:restore": "node scripts/restore-backup.js",
    "backup:verify": "node scripts/verify-backup.js"
  },
  "workspaces": [
    "frontend",
    "services/*",
    "shared/types"
  ],
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "concurrently": "^8.0.0",
    "eslint": "^8.0.0",
    "husky": "^8.0.0",
    "lint-staged": "^13.0.0",
    "prettier": "^3.0.0",
    "standard-version": "^9.5.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mdskmohan/EDG.git"
  },
  "keywords": [
    "data-governance",
    "metadata-management",
    "openmetadata",
    "open-policy-agent",
    "enterprise-data",
    "data-catalog",
    "data-lineage",
    "data-quality"
  ],
  "author": "OpenGovern Team",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/mdskmohan/EDG/issues"
  },
  "homepage": "https://github.com/mdskmohan/EDG#readme",
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged",
      "commit-msg": "commitlint -E HUSKY_GIT_PARAMS"
    }
  }
}