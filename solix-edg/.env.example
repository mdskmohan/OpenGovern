# OpenGovern Environment Configuration
# Copy this file to .env and update the values for your environment

# ===========================================
# APPLICATION SETTINGS
# ===========================================

# Application environment (development, staging, production)
NODE_ENV=development

# Application port (for backend services)
PORT=3001

# Application name
APP_NAME=OpenGovern

# Application version
APP_VERSION=1.0.0

# ===========================================
# DATABASE CONFIGURATION
# ===========================================

# PostgreSQL connection string
DATABASE_URL=postgresql://username:password@localhost:5432/solix_edg

# Database connection pool settings
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT=30000
DB_POOL_ACQUIRE_TIMEOUT=60000

# ===========================================
# CACHE CONFIGURATION
# ===========================================

# Redis connection URL
REDIS_URL=redis://localhost:6379

# Redis connection options
REDIS_PASSWORD=
REDIS_DB=0

# Cache TTL settings (in seconds)
CACHE_TTL_SHORT=300     # 5 minutes
CACHE_TTL_MEDIUM=3600   # 1 hour
CACHE_TTL_LONG=86400    # 24 hours

# ===========================================
# OPENMETADATA INTEGRATION
# ===========================================

# OpenMetadata API base URL
OPENMETADATA_URL=http://localhost:8585/api/v1

# OpenMetadata authentication
OPENMETADATA_USERNAME=admin
OPENMETADATA_PASSWORD=admin

# OpenMetadata connection timeout (in milliseconds)
OPENMETADATA_TIMEOUT=30000

# OpenMetadata retry settings
OPENMETADATA_MAX_RETRIES=3
OPENMETADATA_RETRY_DELAY=1000

# ===========================================
# OPEN POLICY AGENT (OPA) CONFIGURATION
# ===========================================

# OPA server URL
OPA_URL=http://localhost:8181

# OPA policy package name
OPA_PACKAGE=data_governance

# OPA decision endpoint
OPA_DECISION_ENDPOINT=/v1/data

# OPA policy update interval (in minutes)
OPA_POLICY_REFRESH_INTERVAL=5

# ===========================================
# VECTOR DATABASE (AI SEARCH)
# ===========================================

# Vector database URL (Qdrant, Pinecone, etc.)
VECTOR_DB_URL=http://localhost:6333

# Vector database API key (if required)
VECTOR_DB_API_KEY=

# Embedding model configuration
EMBEDDING_MODEL=text-embedding-ada-002
EMBEDDING_DIMENSIONS=1536

# Vector search settings
VECTOR_SEARCH_LIMIT=10
VECTOR_SEARCH_THRESHOLD=0.7

# ===========================================
# AI/ML CONFIGURATION
# ===========================================

# OpenAI API configuration
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_ORGANIZATION_ID=
OPENAI_MODEL=gpt-4

# AI assistant settings
AI_ASSISTANT_ENABLED=true
AI_ASSISTANT_MODEL=gpt-4
AI_ASSISTANT_MAX_TOKENS=2000
AI_ASSISTANT_TEMPERATURE=0.7

# ===========================================
# AUTHENTICATION & SECURITY
# ===========================================

# JWT configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# Session configuration
SESSION_SECRET=your-session-secret-key
SESSION_MAX_AGE=86400000

# OAuth configuration (optional)
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=

# ===========================================
# EMAIL CONFIGURATION
# ===========================================

# SMTP configuration for notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Email settings
EMAIL_FROM=noreply@opengovern.com
EMAIL_FROM_NAME=OpenGovern

# ===========================================
# MONITORING & LOGGING
# ===========================================

# Log level (error, warn, info, debug)
LOG_LEVEL=info

# Log format (json, simple)
LOG_FORMAT=json

# Enable request logging
REQUEST_LOGGING=true

# Metrics collection
METRICS_ENABLED=true
METRICS_PORT=9090

# ===========================================
# FILE STORAGE
# ===========================================

# File storage type (local, s3, gcs)
FILE_STORAGE_TYPE=local

# Local file storage path
FILE_STORAGE_PATH=./uploads

# AWS S3 configuration (if using S3)
AWS_S3_BUCKET=
AWS_S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Google Cloud Storage (if using GCS)
GCS_BUCKET=
GCS_KEY_FILE=

# ===========================================
# INTEGRATION SETTINGS
# ===========================================

# Data source polling interval (in minutes)
DATA_SOURCE_POLL_INTERVAL=15

# Maximum concurrent ingestion jobs
MAX_CONCURRENT_INGESTION_JOBS=5

# Ingestion batch size
INGESTION_BATCH_SIZE=1000

# Enable real-time ingestion
REAL_TIME_INGESTION_ENABLED=true

# ===========================================
# GOVERNANCE SETTINGS
# ===========================================

# Enable automatic policy evaluation
AUTO_POLICY_EVALUATION=true

# Policy evaluation timeout (in seconds)
POLICY_EVALUATION_TIMEOUT=30

# Enable governance workflows
GOVERNANCE_WORKFLOWS_ENABLED=true

# Default approval timeout (in days)
DEFAULT_APPROVAL_TIMEOUT=7

# ===========================================
# QUALITY MONITORING
# ===========================================

# Enable data quality checks
DATA_QUALITY_ENABLED=true

# Quality check interval (in minutes)
QUALITY_CHECK_INTERVAL=60

# Quality threshold for alerts
QUALITY_ALERT_THRESHOLD=0.8

# Enable automated quality reports
AUTO_QUALITY_REPORTS=true

# ===========================================
# ALERT CONFIGURATION
# ===========================================

# Alert delivery methods (email, slack, webhook)
ALERT_DELIVERY_METHODS=email,slack

# Slack webhook URL
SLACK_WEBHOOK_URL=

# Alert batch size
ALERT_BATCH_SIZE=50

# Alert deduplication window (in minutes)
ALERT_DEDUPE_WINDOW=5

# ===========================================
# DEVELOPMENT SETTINGS
# ===========================================

# Enable debug mode
DEBUG=false

# Enable API documentation
API_DOCS_ENABLED=true

# CORS settings
CORS_ORIGIN=http://localhost:3000
CORS_CREDENTIALS=true

# Rate limiting
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=100

# ===========================================
# EXTERNAL SERVICE URLS
# ===========================================

# Frontend URL (for CORS and redirects)
FRONTEND_URL=http://localhost:3000

# API Gateway URL
API_GATEWAY_URL=http://localhost:8000

# Documentation URL
DOCS_URL=http://localhost:3000/docs

# ===========================================
# FEATURE FLAGS
# ===========================================

# Enable experimental features
EXPERIMENTAL_FEATURES=false

# Enable AI-powered features
AI_FEATURES_ENABLED=true

# Enable advanced analytics
ADVANCED_ANALYTICS_ENABLED=true

# Enable multi-tenancy
MULTI_TENANCY_ENABLED=false

# ===========================================
# BACKUP & RECOVERY
# ===========================================

# Enable automatic backups
AUTO_BACKUP_ENABLED=true

# Backup frequency (daily, weekly, monthly)
BACKUP_FREQUENCY=daily

# Backup retention period (in days)
BACKUP_RETENTION_DAYS=30

# Backup storage location
BACKUP_STORAGE_PATH=./backups

# ===========================================
# PERFORMANCE SETTINGS
# ===========================================

# Enable compression
COMPRESSION_ENABLED=true

# Cache headers max age (in seconds)
CACHE_MAX_AGE=3600

# Connection timeout (in milliseconds)
CONNECTION_TIMEOUT=30000

# Request timeout (in milliseconds)
REQUEST_TIMEOUT=60000

# ===========================================
# COMPLIANCE SETTINGS
# ===========================================

# Enable audit logging
AUDIT_LOGGING_ENABLED=true

# Data retention period (in days)
DATA_RETENTION_DAYS=2555

# Enable GDPR compliance features
GDPR_COMPLIANCE_ENABLED=true

# Enable PII detection
PII_DETECTION_ENABLED=true

# ===========================================
# NOTIFICATION SETTINGS
# ===========================================

# Notification batch size
NOTIFICATION_BATCH_SIZE=100

# Notification retry attempts
NOTIFICATION_RETRY_ATTEMPTS=3

# Notification delivery timeout (in seconds)
NOTIFICATION_TIMEOUT=30

# ===========================================
# WORKFLOW SETTINGS
# ===========================================

# Workflow engine (temporal, custom)
WORKFLOW_ENGINE=custom

# Workflow execution timeout (in minutes)
WORKFLOW_TIMEOUT=60

# Maximum concurrent workflows
MAX_CONCURRENT_WORKFLOWS=10

# ===========================================
# DASHBOARD SETTINGS
# ===========================================

# Dashboard refresh interval (in seconds)
DASHBOARD_REFRESH_INTERVAL=30

# Maximum dashboard widgets
MAX_DASHBOARD_WIDGETS=20

# Enable custom dashboards
CUSTOM_DASHBOARDS_ENABLED=true

# ===========================================
# SEARCH SETTINGS
# ===========================================

# Search result limit
SEARCH_RESULT_LIMIT=50

# Search timeout (in seconds)
SEARCH_TIMEOUT=10

# Enable fuzzy search
FUZZY_SEARCH_ENABLED=true

# ===========================================
# EXPORT SETTINGS
# ===========================================

# Maximum export rows
MAX_EXPORT_ROWS=100000

# Export timeout (in minutes)
EXPORT_TIMEOUT=30

# Supported export formats
EXPORT_FORMATS=csv,json,parquet

# ===========================================
# THIRD-PARTY INTEGRATIONS
# ===========================================

# Slack integration
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# Microsoft Teams webhook
TEAMS_WEBHOOK_URL=

# PagerDuty integration key
PAGERDUTY_INTEGRATION_KEY=

# DataDog API key
DATADOG_API_KEY=
DATADOG_APP_KEY=

# New Relic license key
NEW_RELIC_LICENSE_KEY=

# ===========================================
# CLUSTER CONFIGURATION (for production)
# ===========================================

# Kubernetes namespace
K8S_NAMESPACE=opengovern

# Service account name
K8S_SERVICE_ACCOUNT=opengovern-sa

# Ingress class
INGRESS_CLASS=nginx

# Certificate issuer (for SSL)
CERT_ISSUER=letsencrypt-prod

# ===========================================
# CLOUD CONFIGURATION (AWS/GCP/Azure)
# ===========================================

# Cloud provider (aws, gcp, azure)
CLOUD_PROVIDER=

# AWS region
AWS_REGION=us-east-1

# GCP project ID
GCP_PROJECT_ID=

# Azure subscription ID
AZURE_SUBSCRIPTION_ID=

# ===========================================
# CONTAINER REGISTRY
# ===========================================

# Container registry URL
CONTAINER_REGISTRY=docker.io/mdskmohan

# Image pull secrets
IMAGE_PULL_SECRETS=

# ===========================================
# CI/CD SETTINGS
# ===========================================

# CI/CD pipeline type (github-actions, gitlab-ci, jenkins)
CI_CD_TYPE=github-actions

# Deployment environment
DEPLOYMENT_ENV=staging

# Rollback enabled
ROLLBACK_ENABLED=true

# Blue-green deployment
BLUE_GREEN_DEPLOYMENT=false

# ===========================================
# SUPPORT & MAINTENANCE
# ===========================================

# Support email
SUPPORT_EMAIL=support@opengovern.com

# Maintenance mode
MAINTENANCE_MODE=false

# Maintenance message
MAINTENANCE_MESSAGE="System is under maintenance. Please try again later."

# ===========================================
# ADVANCED CONFIGURATION
# ===========================================

# Custom configuration file path
CUSTOM_CONFIG_PATH=

# Plugin directory
PLUGIN_DIR=./plugins

# Extension directory
EXTENSION_DIR=./extensions

# Theme configuration
THEME=light
CUSTOM_THEME_PATH=

# Internationalization
DEFAULT_LANGUAGE=en
SUPPORTED_LANGUAGES=en,es,fr,de

# Timezone
DEFAULT_TIMEZONE=UTC

# Date format
DEFAULT_DATE_FORMAT=YYYY-MM-DD

# Number format
DEFAULT_NUMBER_FORMAT=en-US